{
  "name": "niulai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "start": "next start",
    "test:call-exit": "node --import tsx spec/test-call-exit-policy.ts",
    "test:call-ticket": "node --import tsx spec/test-call-ticket.ts",
    "test:call-readiness": "node --import tsx spec/test-call-readiness.ts",
    "test:microphone": "node --import tsx spec/test-microphone-permission.ts",
    "test:api": "node --import tsx spec/test-api-contracts.ts",
    "test:agent-config": "node --import tsx spec/test-agent-config.ts",
    "test:cow": "node --import tsx spec/test-cow-rig.ts",
    "test": "pnpm test:call-exit && pnpm test:call-ticket && pnpm test:call-readiness && pnpm test:microphone && pnpm test:api && pnpm test:agent-config && pnpm test:cow",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "lint": "eslint ."
  },
  "dependencies": {
    "agora-agent-client-toolkit": "1.2.0",
    "agora-agents": "2.3.1",
    "agora-rtc-react": "2.5.1",
