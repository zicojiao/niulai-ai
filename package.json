    "agora-rtm": "2.2.3",
    "agora-token": "2.0.5",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
